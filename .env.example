OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional. Free key from https://carto.com/basemaps/apikey — otherwise Esri street tiles.
NEXT_PUBLIC_CARTO_API_KEY=
# Recommended for India deployments. Loads Google Maps with region set to IN.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Demo builds only — shows the "Try a sample report" shortcut in Report step 1.
# Unset never renders it; set it explicitly to "false" so the markup is also
# compiled out of a production bundle.
NEXT_PUBLIC_DEMO_SAMPLE=false
